# ============================================================
# Секреты — никогда не коммитим
# ============================================================
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
service_account*.json
secrets/

# ============================================================
# Данные — учебная база живёт на сервере, локальные выгрузки
# в репозиторий не попадают
# ============================================================
*.csv
*.parquet
*.db
*.sqlite3
data/
данные/*.csv
данные/*.parquet
!данные/**/*.md

# ============================================================
# Python
# ============================================================
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/

# ============================================================
# Jupyter
# ============================================================
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# ============================================================
# LaTeX — промежуточные файлы сборки слайдов.
# Сами .tex и собранный .pdf публикуются вместе с темой.
# ============================================================
*.aux
*.fdb_latexmk
*.fls
*.log
*.nav
*.out
*.snm
*.toc
*.synctex.gz
*.vrb
*.xdv

# ============================================================
# Системное и редакторы
# ============================================================
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp


# ============================================================
# Other
# ============================================================
CLAUDE.md


# ============================================================
# ВРЕМЕННО НА ВРЕМЯ ЧТЕНИЯ КУРСА: публикуем по мере прохождения
#
# Содержимое лекция/ и семинар/ скрыто по умолчанию — черновики
# не должны попадать студентам раньше занятия. README тем при этом
# видны: они и есть анонс, ссылки в главном README не бьются.
#
# Тема прошла у ОБЕИХ групп -> раскомментировать её пару строк ниже.
# Если нужны только слайды — достаточно !тема/лекция/*.pdf
# Курс дочитан -> удалить весь этот блок целиком.
# ============================================================
*/лекция/**
*/семинар/**
!*/лекция/.gitkeep
!*/семинар/.gitkeep

# --- опубликованные темы (раскомментировать по мере прохождения) ---
#
# Исключение из правила «после обеих групп»: ноутбук С1 открыт ДО семинара.
# Иначе студенту нечего клонировать: он приходит на пару с репозиторием,
# в котором нет ноутбука, и первые двадцать минут уходят на раздачу файла.
# Это рабочий лист, который мы прогоняем вместе, а не проверочная работа, —
# терять от предпросмотра нечего.
!01-профессия-и-ландшафт/лекция/*.pdf
!01-профессия-и-ландшафт/семинар/*.ipynb
# !01-профессия-и-ландшафт/лекция/**
# !01-профессия-и-ландшафт/семинар/**
!02-среда-git-python/лекция/*.pdf
# То же исключение, что и у С1: материалы семинара открыты ДО пары.
# Оба файла нужны студенту на руках в момент начала: практикум он читает
# с экрана, пока набирает команды в терминале, а ноутбук открывает из
# клона репозитория. Раздавать их в аудитории — потерянные двадцать минут.
!02-среда-git-python/семинар/*.md
!02-среда-git-python/семинар/*.ipynb
# !02-среда-git-python/лекция/**
# !02-среда-git-python/семинар/**
# !03-pandas-модель-данных/лекция/**
# !03-pandas-модель-данных/семинар/**
# !04-соединения-и-агрегации/лекция/**
# !04-соединения-и-агрегации/семинар/**
# !05-время-и-метрики/лекция/**
# !05-время-и-метрики/семинар/**
# !06-факторный-анализ/лекция/**
# !06-факторный-анализ/семинар/**
# !07-пилоты-постановка/лекция/**
# !07-пилоты-постановка/семинар/**
# !08-анализ-пилота/лекция/**
# !08-анализ-пилота/семинар/**
# !09-из-ноутбука-в-решение/лекция/**
# !09-из-ноутбука-в-решение/семинар/**
# !10-источники-и-хранилища/лекция/**
# !10-источники-и-хранилища/семинар/**
# !11-качество-и-доставка/лекция/**
# !11-качество-и-доставка/семинар/**
# !12-ии-инструменты/лекция/**
# !12-ии-инструменты/семинар/**

# ============================================================
# ВРЕМЕННО: тексты заданий по проектам скрыты до выдачи.
#
# Смотреть их в сентябре рано — задача первых недель другая.
# Обзорная страница проекты/README.md остаётся видимой: в ней
# только веса и сроки, которые и так объявлены в README курса,
# и на неё ссылается таблица оценивания.
#
# Проект 1 выдаётся 19.09 -> раскомментировать первую строку
# и вернуть ссылку на подпапку в проекты/README.md.
# Итоговый проект выдаётся 07.11 -> то же со второй строкой.
# Оба выданы -> удалить этот блок целиком.
# ============================================================
проекты/проект-1/**
проекты/итоговый-проект/**

# !проекты/проект-1/**
# !проекты/итоговый-проект/**

# ============================================================
# ВРЕМЕННО: тексты домашних заданий скрыты до дня выдачи.
#
# Обзорная страница задания/README.md остаётся видимой: в ней только
# сроки, форма сдачи и рубрика — то, что и так объявлено в README
# курса, и на неё ссылается таблица оценивания.
#
# ДЗ-1 выдано 13.09 -> строка-исключение уже раскомментирована.
# ДЗ-2 выдаётся 26.09, ДЗ-3 — 14.11, ДЗ-4 — 28.11:
# раскомментировать соответствующую строку в день выдачи
# и вернуть ссылку на подпапку в задания/README.md.
# Все четыре выданы -> удалить этот блок целиком.
#
# Проверять видимость только через git check-ignore -q (код 1 = файл
# виден студенту) или git status: check-ignore -v возвращает 0 и на
# строку-исключение.
# ============================================================
задания/дз-*/**

# Исключения — только маски файлов (*.md, *.ipynb), не /**: иначе в публикацию
# снова попадают .ipynb_checkpoints, .env и выгрузки из папки задания.
!задания/дз-1-окружение-и-репозиторий/*.md
!задания/дз-1-окружение-и-репозиторий/*.ipynb
# !задания/дз-2-витрина-клиента/*.md
# !задания/дз-2-витрина-клиента/*.ipynb
# !задания/дз-3-пилот/*.md
# !задания/дз-3-пилот/*.ipynb
# !задания/дз-4-источники-и-хранилища/*.md
# !задания/дз-4-источники-и-хранилища/*.ipynb

# Страховка на всё дерево: автосохранения Jupyter не публикуются никогда,
# какие бы исключения ни стояли выше.
**/.ipynb_checkpoints/

